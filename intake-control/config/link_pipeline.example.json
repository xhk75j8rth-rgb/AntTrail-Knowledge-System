{
  "siyuan_base_url": "http://127.0.0.1:6806",
  "siyuan_token_env_name": "SIYUAN_TOKEN",
  "default_notebook": "__CONFIGURE_ME__",
  "inbox_path": "00_Inbox/临时收集箱",
  "fallback_path": "00_Inbox",
  "runtime_dir": "runtime/jobs",
  "enable_page_fetch": true,
  "enable_transcribe": true,
  "enable_ocr": true,
  "enable_comments": true,
  "enable_ai_composer": true,
  "enable_storage_write": true,
  "storage_targets": ["lucas_database"],
  "enable_lucas_database_write": true,
  "lucas_database_write_policy": "all_cards",
  "strict_card_composer": true,
  "composer_require_model": true,
  "quality_gate_required": true,
  "enable_codex_exec": false,
  "codex_command": "codex exec",
  "ocr_policy": "conditional",
  "comments_policy": "opportunistic",
  "temp_root": "%TEMP%",
  "douyin_temp_dir_name": "LucasDouyinTranscribe",
  "ocr_temp_dir_name": "LucasVideoOCR",
  "max_ocr_frames": 10,
  "transcribe_timeout_sec": 300,
  "ocr_timeout_sec": 180,
  "composer_timeout_sec": 300,
  "lucas_database_timeout_sec": 30,
  "taxonomy_tree_path": "runtime/taxonomy_tree.json",
  "taxonomy_tree_merge_seed": false,
  "taxonomy_refresh_from_siyuan": false,
  "taxonomy_refresh_timeout_sec": 30,
  "taxonomy_tree_max_depth": 4,
  "taxonomy_auto_create_from_proposal": false,
  "siyuan_use_taxonomy_path": true,
  "taxonomy_export_root_path": "/",
  "siyuan_taxonomy_root_path": "",
  "siyuan_duplicate_policy": "skip_exact_path",
  "cleanup_temp_after_hours": 36,
  "low_confidence_policy": "write_temporary_card_to_inbox",
  "failure_card_policy": "write_failure_card_to_inbox"
}
