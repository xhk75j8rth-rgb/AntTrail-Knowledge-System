{
  "name": "lucas-openclaw-retrieval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenClaw tool plugin for Lucas Database Agent Retrieve API.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --root . --entry ./dist/index.js",
    "plugin:validate": "openclaw plugins validate --root . --entry ./dist/index.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "dependencies": {
    "typebox": "^1.1.39"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "openclaw": "2026.6.10",
    "typescript": "^5.7.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
